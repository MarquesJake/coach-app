  "notes": {
    "de-zerbi": {
      "signal": "Different outcomes in different environments",
      "support": "48 points with Brighton in 2023/24 and 65 with Marseille in 2024/25 — two full league seasons. Marseille scored 74. His attacking ideas have worked at more than one club.",
      "challenge": "Brighton took 30 points from the first 19 games and only 18 from the second 19. The question is whether he can keep it going over a season, not just whether the idea is good. Different leagues and squads, though.",
      "question": "What kept the chances coming, and what depended on who was fit or who they played?"
    },
    "mckenna": {
      "signal": "Proven in promotions; Premier League still a question",
      "support": "98 points in League One and 96 in the Championship, scoring 101 and 92. Clear evidence he can build an attacking team and get a model in quickly.",
      "challenge": "In the 2024/25 Premier League they took 22 points from 38 games and conceded 82. A step up in division, so not a straight comparison — but it is a real doubt over whether he can steady a Premier League side quickly.",
      "question": "With a different squad, what would he change to be harder to beat and adapt faster?"
    },
    "hoeness": {
      "signal": "A real turnaround, followed by a substantial drop",
      "support": "Stuttgart had 20 points from 26 games before he arrived in April 2023, then took 13 from the last eight. The next full season: 73 points and +39 goal difference.",
      "challenge": "The season after that dropped to 50 points and +11. Eight games is a small sample, and signings, sales, injuries and Europe all need weighing before we credit the coaching.",
      "question": "What part of the improvement held up once the squad and fixture load changed?"
    },
    "knutsen": {
      "signal": "Consistent at home; unproven elsewhere",
      "support": "70 points and 78 goals in 2023, then 62 points and 71 goals in 2024, both from 30 games. Goals conceded down from 38 to 31.",
      "challenge": "That is the Norwegian league, at a club built around him. A better points-per-game does not make him a better Premier League appointment than the others.",
      "question": "What could he put in place in six weeks without the set-up that produced those results?"
    },
    "silva": {
      "signal": "A steadier Premier League comparison",
      "support": "52, 47 and 54 points with Fulham from 2022/23 to 2024/25 — three full Premier League seasons.",
      "challenge": "Goal differences of +2, −6 and 0. Solid and reliable, but it does not show the attacking level or step up Tottenham need.",
      "question": "What would take a team beyond steady mid-table?"
    },
    "terzic": {
      "signal": "Look beyond the memorable European run",
      "support": "71 points in 2022/23 and 63 in 2023/24 — the second season also included a Champions League final.",
      "challenge": "League goals dropped from 83 to 68 while goals conceded barely moved (44 to 43). Judge the cup runs and the weekly attacking output separately.",
      "question": "How would he create chances regularly against teams who sit deep?"
    },
    "farioli": {
      "signal": "A measurable defensive improvement",
      "support": "Ajax went from 56 points and 61 conceded in 2023/24 to 78 points and 32 conceded in his one season. His Nice side before that conceded just 29 in 34 games.",
      "challenge": "But Ajax’s goals scored fell from 74 to 67. It points to a coach who makes teams hard to beat more than one who adds goals. Squad changes and budget not yet allowed for.",
      "question": "Can he make Spurs harder to beat and still create the chances they need?"
    }
  },
