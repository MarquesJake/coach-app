{
  "name": "coach-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-build-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:demo": "node scripts/verify-demo-readiness.mjs",
    "test:rls": "npm run test:rls:roles && npm run test:rls:onboarding && npm run test:rls:materials && npm run test:rls:corpus",
    "test:rls:corpus": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/internal_corpus_rls.sql",
    "test:rls:roles": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/club_identity_rls.sql",
    "test:rls:onboarding": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/external_identity_onboarding_rls.sql",
    "test:rls:materials": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/coach_material_upload_rls.sql",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/types/database.ts",
    "db:types:project": "supabase gen types typescript --project-id $SUPABASE_PROJECT_REF --schema public > src/lib/types/database.ts",
    "db:types:db-url": "supabase gen types typescript --db-url $SUPABASE_DB_URL --schema public > src/lib/types/database.ts",
    "db:types:local": "supabase gen types typescript --local --schema public > src/lib/types/database.ts"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "postcss": "^8",
    "supabase": "^2.76.9",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
